{
  "expo": {
    "name": "Gym Workout Companion",
    "slug": "gym-workout-companion",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "gymcompanion",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B1220"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "dev.gymcompanion.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0B1220"
      },
      "package": "dev.gymcompanion.app"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-document-picker",
        {
          "iCloudContainer": true,
          "UTType": [
            "public.json",
            "public.text"
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "updates": {
      "url": "https://u.expo.dev/4ed9dedd-f0cd-40fb-8496-701a2d4b46ad",
      "enabled": true,
      "fallbackToCacheTimeout": 0,
      "checkAutomatically": "ON_LOAD"
    },
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "4ed9dedd-f0cd-40fb-8496-701a2d4b46ad"
      }
    },
    "owner": "geek_0.2"
  }
}
