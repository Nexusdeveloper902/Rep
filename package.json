{
  "name": "gym-workout-companion",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest --config jest.config.js",
    "test:core": "jest --config jest.core.config.js",
    "test:watch": "jest --watch",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.js"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|react-navigation|@react-navigation/.*|@sentry/react-native|native-base|react-native-paper|react-native-vector-icons|lucide-react-native)"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    },
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/e2e/"
    ]
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "3.1.1",
    "expo": "~57.0.12",
    "expo-document-picker": "~57.0.1",
    "expo-file-system": "~57.0.2",
    "expo-router": "~57.0.12",
    "expo-sharing": "~57.0.11",
    "expo-sqlite": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "^57.0.2",
    "lucide-react-native": "^1.31.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-native": "^0.86.2",
    "react-native-paper": "^5.12.5",
    "react-native-safe-area-context": "5.9.0",
    "react-native-screens": "4.27.0",
    "react-native-web": "~0.20.0",
    "zod": "^3.23.8",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@react-native/jest-preset": "^0.86.2",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.12",
    "@types/react": "~19.2.0",
    "babel-plugin-module-resolver": "^5.0.2",
    "eslint": "^8.57.0",
    "eslint-config-expo": "^7.1.2",
    "expo-linking": "^57.0.5",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.4",
    "react-test-renderer": "19.2.8",
    "typescript": "~5.3.3"
  },
  "private": true
}
